# =============================================================
# NORTHSTONE REALTY — Environment Variable Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# =============================================================

# The released reference build requires no environment variables. When omitted
# on Vercel, the canonical origin is derived from Vercel system variables.
# Site override (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Northstone Realty

# Legacy Phase 2 database tools only. The public reference build, Customer
# Portal, and Operations Console do not connect to or mutate MongoDB.
# MongoDB — must point to northstone_realty_dev (dev) or northstone_realty_prod (prod)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/northstone_realty_dev?retryWrites=true&w=majority
EXPECTED_DB_NAME=northstone_realty_dev

# Keyed hashing salt for durable rate-limit identifiers (32+ random characters)
RATE_LIMIT_SALT=generate-a-separate-random-secret-32-chars-minimum

# NextAuth
NEXTAUTH_SECRET=generate-a-strong-random-secret-32-chars-minimum
NEXTAUTH_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin seed credentials — read by seed script only, never hardcoded
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=

# Production seed override — never set without explicit production approval
# ALLOW_SEED=false

# Optional future delivery integration; unused by the reference build.
# RESEND_API_KEY=
# EMAIL_FROM=
